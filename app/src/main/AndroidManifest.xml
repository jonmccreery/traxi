<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      minSdk is 31, so only the modern Bluetooth permission model is declared.
      No BLUETOOTH / BLUETOOTH_ADMIN with maxSdkVersion, and no
      ACCESS_FINE_LOCATION: neverForLocation on the scan permission tells the
      platform we do not derive location from Bluetooth results, which removes
      the location prompt entirely. On a phone that is also the only computer
      in the field, every prompt avoided is one less thing to fail at a
      trailhead.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      A full dump is 20-25 minutes over RFCOMM. Without a foreground service it
      does not survive the screen going off in a pocket.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      A foreground service keeps the process running, but on this phone it does
      not by itself exempt it from battery optimisation, which is what suspends
      a long idle-connected session. The app never asks for this silently: the
      Device tab shows whether the exemption is held and the user grants it.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <!--
      Required to call CompanionDeviceManager at all. Without this declaration
      associate() throws IllegalStateException synchronously rather than
      reporting through its failure callback, which crashes the app on the
      first tap of "Pair a logger".

      required="false" because pairing degrades gracefully: if CDM is
      unavailable the app falls back to the list of already-bonded devices,
      which is enough to reach a logger that was paired in system settings.
    -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!--
      USB host, for the far faster transport: 64 KB/s against Bluetooth's
      493 B/s on the same chip. required="false" so the app still installs on a
      phone without OTG, where Bluetooth remains the only path.
    -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:name=".TraxiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Traxi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Traxi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offer the app when the logger is plugged in over OTG. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <service
            android:name=".service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          Holds the process up for the whole of a connected session, not just a
          transfer. An idle-connected app is background work as far as Android
          is concerned, and the cached-app freezer suspends it within minutes;
          the Bluetooth link then stalls while staying nominally connected.
        -->
        <service
            android:name=".service.LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Grants read access to exported GPX and transcripts only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
