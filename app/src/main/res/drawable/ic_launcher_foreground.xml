<?xml version="1.0" encoding="utf-8"?>
<!-- A satellite over a track line: the two halves of what this app does. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- orbit arc -->
    <path
        android:pathData="M30,42 A24,24 0 0 1 78,42"
        android:strokeColor="#7FD4C1"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- satellite body -->
    <path
        android:pathData="M50,34 h8 v8 h-8 z"
        android:fillColor="#F2E4C9" />
    <!-- solar panels -->
    <path
        android:pathData="M38,35.5 h10 v5 h-10 z M60,35.5 h10 v5 h-10 z"
        android:fillColor="#7FD4C1" />

    <!-- signal cone -->
    <path
        android:pathData="M54,44 L44,62 L64,62 Z"
        android:fillColor="#F2E4C9"
        android:fillAlpha="0.35" />

    <!-- track -->
    <path
        android:pathData="M32,74 L44,66 L54,72 L66,60 L78,68"
        android:strokeColor="#F2E4C9"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
